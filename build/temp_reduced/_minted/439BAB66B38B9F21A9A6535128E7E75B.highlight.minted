\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{n}{has\PYGZus{}ticket} \PYG{o}{=} \PYG{k+kc}{True}
\PYG{n}{has\PYGZus{}secret\PYGZus{}word} \PYG{o}{=} \PYG{k+kc}{False}

\PYG{k}{if} \PYG{n}{has\PYGZus{}ticket}\PYG{p}{:}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+s2}{ticket accepted}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{)}

    \PYG{k}{if} \PYG{n}{has\PYGZus{}secret\PYGZus{}word}\PYG{p}{:}
        \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+s2}{Nobody expects the Spanish Inquisition!}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{)}
    \PYG{k}{else}\PYG{p}{:}
        \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+s2}{ordinary entrance}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{)}

\PYG{k}{else}\PYG{p}{:}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+s2}{no ticket, no entrance}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{)}

\PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+s2}{gate check finished}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{)}
\end{MintedVerbatim}
