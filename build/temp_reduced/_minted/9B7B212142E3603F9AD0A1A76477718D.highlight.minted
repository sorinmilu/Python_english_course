\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{n}{name} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+s2}{Bart}\PYG{l+s+s2}{\PYGZdq{}}
\PYG{n}{age} \PYG{o}{=} \PYG{l+m+mi}{10}

\PYG{k}{if} \PYG{n}{name} \PYG{o}{==} \PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+s2}{Bart}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{:}
